{
  "name": "nestly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "lint": "eslint --max-warnings 0 .",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:tools": "node --test tools/eslint-rules/no-cross-feature-import.test.mjs .claude/hooks/guard.test.js"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
