{
  "name": "nestly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "lint": "eslint --max-warnings 0 .",
    "tokens": "node tools/build-design-tokens.js",
    "tokens:check": "node tools/build-design-tokens.js && git diff --exit-code -- apps/web/src/styles/tokens.generated.css",
    "ci": "npm run typecheck && npm run lint && npm run tokens:check && npm test && npm run build && npm run test:build",
    "test:build": "node --test tools/built-css.test.mjs",
    "test:tools": "node --test tools/design-gates.test.mjs tools/eslint-rules/no-cross-feature-import.test.mjs .claude/hooks/guard.test.js"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
