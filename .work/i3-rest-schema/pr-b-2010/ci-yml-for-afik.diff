             *) echo "::error::02-anchor-fk-check.sql: ok is not true"; exit 1 ;;
           esac
 
+      # Bootstrap step 3 (I3 PR-B, DATA ARCHITECT 20.10 fallback A2): the purge schedule, as postgres, after the migrations
+      # that create the function. Twice (idempotent), then its check, then step 1's check in its "after step 3" state.
+      - name: Bootstrap step 3 (purge schedule) as postgres, twice, then its check and the step-1 check
+        env:
+          PGUSER: postgres
+          PGPASSWORD: ${{ env.CI_POSTGRES_PASSWORD }}
+        run: |
+          set -eu
+          psql -X -q -v ON_ERROR_STOP=1 -f supabase/bootstrap/03-cron.sql
+          psql -X -q -v ON_ERROR_STOP=1 -f supabase/bootstrap/03-cron.sql
+          result="$(psql -X -q -A -t -F ' | ' -v ON_ERROR_STOP=1 -f supabase/bootstrap/03-cron-check.sql)"
+          echo "ok | extension | jobs | schedule | command | username | active | database | nestly_jobs | app_jobs_jobs | no_cron_usage | set_membership"
+          echo "${result}"
+          case "${result}" in
+            "t | "*) ;;
+            *) echo "::error::03-cron-check.sql: ok is not true"; exit 1 ;;
+          esac
+          roles="$(psql -X -q -A -t -F ' | ' -v ON_ERROR_STOP=1 -f supabase/bootstrap/01-roles-check.sql)"
+          echo "${roles}"
+          if echo "${roles}" | awk -F ' [|] ' '$2 != "t" { bad = 1 } END { exit !bad }'; then
+            echo "::error::01-roles-check.sql: a role is not ok after step 3"
+            exit 1
+          fi
+
