{
  "name": "@nestly/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"tests/db/**\"",
    "test:db": "vitest run tests/db/",
    "db:drift": "tsx --conditions=source scripts/db-drift.ts"
  },
  "dependencies": {
    "@nestly/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
