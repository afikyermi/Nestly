# Word / Office lock files — created while a .docx (e.g. the SRS) is open
~$*

# Secrets — never commit (Supabase keys and similar). Also denied in .claude/settings.json
.env
.env.*

# Dependencies and build output
node_modules/
dist/
build/

# Generated Word exports of the SRS — regenerate with tools/export-srs-docx.js, never edit
exports/

# Per-machine Claude settings
.claude/settings.local.json

# OS
Thumbs.db
desktop.ini
.DS_Store

# Environment templates are the one tracked exception to the .env.* rule above
!.env.example

# Vercel, TypeScript and test output
.vercel/
*.tsbuildinfo
coverage/

# Storybook static build and Playwright output
storybook-static/
test-results/
playwright-report/
