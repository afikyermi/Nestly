# Word / Office lock files — created while a .docx (e.g. the SRS) is open
~$*

# Secrets — never commit (Supabase keys and similar). Also denied in .claude/settings.json
.env
.env.*

# Dependencies and build output
node_modules/
dist/
dist-e2e/
build/

# Generated Word exports of the SRS — regenerate with tools/export-srs-docx.js, never edit
exports/

# Per-machine Claude settings
.claude/settings.local.json

# Local hook block log (guard.js); /wrap-up reads it
.claude/logs/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Environment templates are the one tracked exception to the .env.* rule above
!.env.example

# Vercel, TypeScript and test output
.vercel/
*.tsbuildinfo
coverage/

# Storybook static build and Playwright output
storybook-static/
test-results/
playwright-report/

# A local event log some machines keep here; never part of the project
.live/

# Generated by tools/critic-diff.mjs
.work/*/review.diff

# Supabase CLI local cache
supabase/.temp/
