{
  "$comment": [
    "Guardrails layer. These are enforced by the harness, not by prompt text.",
    "Deny rules are prefix-matched and are a fence, not a vault: an equivalent command can be",
    "constructed that a prefix rule does not match. A PreToolUse hook is the stronger control and",
    "is the next step — see README. Until it exists, treat this file as the first line, not the only one."
  ],
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git remote add:*)",
      "Bash(psql:*)",
      "Bash(dropdb:*)",
      "Bash(supabase db reset:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm publish:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ],
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(node tools/db-preview.mjs:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(supabase:*)",
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./decisions.md)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\" all"
          }
        ]
      },
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "UserPromptExpansion": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/situation-log.js\"", "timeout": 2 }] }
    ]
  }
}
